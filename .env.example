# Copy to backend/.env. Run Java/IDEA with backend as the working directory.
# Parsed as Java properties: no wrapping quotes; use / in Windows paths.
SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8080
MYSQL_HOST=127.0.0.1
MYSQL_PUBLISHED_PORT=3306
MYSQL_DATABASE=superfurniyure
MYSQL_USER=superfurniyure
MYSQL_PASSWORD=
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0
# Fill with your own random signing secret (at least 32 characters).
TOKEN_SECRET=
# Set only when initializing an administrator for a fresh database.
ADMIN_INITIAL_PASSWORD=
MAIL_ENABLED=false
